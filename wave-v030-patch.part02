n:.65rem 0}.playlist-add-row{display:grid;grid-template-columns:1fr auto;gap:.45rem;margin:.65rem 0}.artist-stats{display:flex;gap:.75rem;color:var(--muted);font-size:.68rem;margin:.45rem 0 .7rem}.playlist-track{display:grid;grid-template-columns:1fr auto;gap:.45rem;align-items:center;background:var(--panel);border-radius:.75rem;padding:.6rem;margin:.4rem 0}.playlist-track strong,.playlist-track span{display:block}.playlist-track span{color:var(--muted);font-size:.64rem}.playlist-track button{padding:.45rem .55rem}.track-meta.clickable{cursor:pointer}
 #albumManager input,#albumManager textarea,#albumManager select{margin:.35rem 0}.album-track-choices{display:grid;gap:.35rem;max-height:12rem;overflow:auto;margin:.55rem 0}.album-choice{display:flex;align-items:center;gap:.45rem;background:#0d1728;border-radius:.65rem;padding:.55rem;font-size:.68rem;color:#dbeafe}.album-choice input{width:auto;margin:0}.album-chip{position:relative;min-width:8.5rem;background:#0d1728;color:#f8fafc;text-align:left}.album-chip strong,.album-chip span{display:block}.album-chip span{font-size:.62rem;color:var(--muted);margin-top:.15rem}.album-list{display:flex;gap:.45rem;overflow:auto;margin:.55rem 0}.album-public-chip{min-width:8rem;background:var(--panel);color:#fff;text-align:left}.album-public-chip strong,.album-public-chip span{display:block}.album-public-chip span{font-size:.62rem;color:var(--muted);margin-top:.2rem}
 .bar-tools{display:flex;gap:.35rem;flex-wrap:wrap;margin-top:.55rem}.bar-tools button{padding:.5rem .65rem}.studio-actions{flex-wrap:wrap}.transport .switch-row{align-self:center}.transport .switch-row input{width:auto}
+
+.studio-title{min-width:0;flex:1}.project-title-input{border:0;background:transparent;padding:.12rem 0;font-size:1.25rem;font-weight:800;color:#fff;border-radius:0}.project-title-input:focus{outline:none;border-bottom:.08rem solid var(--accent)}.publish-feedback{margin-top:.55rem;padding:.55rem .65rem;border-radius:.65rem;background:rgba(34,211,238,.08);color:#bae6fd}.publish-feedback.bad{background:rgba(251,113,133,.09);color:#fecdd3}.publish-card button:disabled{opacity:.55;cursor:default}
+
+.release-manager-list{display:grid;gap:.45rem}.release-manager-row{display:grid;grid-template-columns:1fr auto;gap:.5rem;align-items:center;background:#0d1728;border-radius:.75rem;padding:.6rem}.release-manager-row strong,.release-manager-row span{display:block}.release-manager-row span{font-size:.62rem;color:var(--muted);margin-top:.15rem}.release-manager-actions{display:flex;gap:.3rem;flex-wrap:wrap;justify-content:flex-end}.release-manager-actions button{padding:.45rem .55rem;font-size:.64rem}
